{
  "mcpServers": {
    "headroom": {
      "type": "stdio",
      "command": "@@HOME@@/.venv/bin/headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "claude-code",
        "--open-web-dashboard",
        "False"
      ],
      "env": {}
    }
  }
}
